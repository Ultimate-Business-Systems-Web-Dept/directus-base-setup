# Database
DB_CLIENT="pg"
DB_HOST="database"
DB_PORT="5432"
DB_DATABASE="postgres"
DB_USER="postgres"
DB_PASSWORD="[DATABASE_PASSWORD]"

# Initial Admin
ADMIN_EMAIL="[ADMIN_EMAIL]"
ADMIN_PASSWORD="[ADMIN_PASSWORD]"

# Security
KEY="[local-dev-key-change-in-production]"
SECRET="[local-dev-secret-change-in-production]"

# Directus
PUBLIC_URL="http://localhost:8055"
EXTENSIONS_AUTO_RELOAD="true"
EXTENSIONS_PATH="/directus/extensions"

# Production AWS S3 Media Configuration
STORAGE_LOCATIONS="s3"
STORAGE_S3_DRIVER="s3"
STORAGE_S3_KEY="[S3_KEY]"
STORAGE_S3_SECRET="[S3_SECRET]"
STORAGE_S3_REGION="ap-southeast-2"
STORAGE_S3_BUCKET="directus-{CUSTOMER_NAME}-s3-storage"
STORAGE_S3_PUBLIC_URL="https://directus-{CUSTOMER_NAME}-s3-storage.s3.ap-southeast-2.amazonaws.com"

# Schema Sync
SCHEMA_SYNC_PATH="/directus/snapshot/schema.yaml"
